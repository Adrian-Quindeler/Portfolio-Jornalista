---
import { getCldUrl } from "../lib/cloudinary";

interface Props {
    title: string;
    image: string;
    href: string;
}

const { title, image, href } = Astro.props;
const imageUrl = getCldUrl(image, { width: 800, crop: "fill" });
---

<a href={href} class="photo-card">
    <img src={imageUrl} alt={title} loading="lazy" decoding="async" />

    <div class="photo-card-overlay">
        <h2>{title}</h2>
    </div>
</a>
