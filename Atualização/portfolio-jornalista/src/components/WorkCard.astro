---
import { getCldUrl } from "../lib/cloudinary";

interface Props {
    title: string;
    description: string;
    image: string;
    href: string;
    linkLabel?: string;
}

const {
    title,
    description,
    image,
    href,
    linkLabel = "Ver trabalho",
} = Astro.props;

const isLocalOrRemote =
    !image ||
    image === "..." ||
    image.startsWith("http") ||
    image.startsWith("/");
const imageUrl = isLocalOrRemote
    ? image === "..."
        ? ""
        : image
    : getCldUrl(image, { width: 800, crop: "fill" });
---

<article class="work-card">
    <div class="image-container">
        {imageUrl && (
            <img src={imageUrl} alt={title} loading="lazy" decoding="async" />
        )}
    </div>

    <div class="content">
        <h2>{title}</h2>
        <p>{description}</p>

        <a
            href={href}
            class="button button-primary"
            target="_blank"
            rel="noopener noreferrer"
        >
            {linkLabel}
        </a>
    </div>
</article>
