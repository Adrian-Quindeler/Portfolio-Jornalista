---
interface Props {
    title: string;
    description: string;
    image: string;
    href: string;
    linkLabel?: string;
}

const { title, description, image, href, linkLabel = "Ver trabalho", } = Astro.props;
---

<article class="work-card">
    <div class="image-container">
        <img src={image} alt={title} />
    </div>

    <div class="content">
        <h2>{title}</h2>
        <p>{description}</p>

        <a href={href}
           class="button button-primary"
           target="_blank"
           rel="noopener noreferrer"
        >
            {linkLabel}
        </a>
    </div>
</article>