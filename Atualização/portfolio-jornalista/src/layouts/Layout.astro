---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "Mariana Bernardino - Jornalista" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <meta
            name="description"
            content="Portfólio profissional de Mariana Bernardino, jornalista."
        />

        <title>{title}</title>
        <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
    </head>

    <body>
        <Header />

        <main>
            <slot />
        </main>

        <Footer />
    </body>
</html>