---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "@fortawesome/fontawesome-free/css/all.min.css";
import "../styles/themes.css";
import "../styles/global.css";
import "../styles/trabalhos.css";
import "../styles/fotografias.css";

interface Props {
    title?: string;
}

const { title = "Mariana Bernardino - Jornalista" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Portfólio profissional de Mariana Bernardino, jornalista."/>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet"/>
        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem("theme");
                    var theme =
                        stored === "dark" || stored === "light"
                            ? stored
                            : window.matchMedia("(prefers-color-scheme: dark)")
                                    .matches
                              ? "dark"
                              : "light";
                    document.documentElement.dataset.theme = theme;
                } catch (e) {
                    /* ignore */
                }
            })();
        </script>
    </head>

    <body>
        <Header />

        <main>
            <slot />
        </main>

        <Footer />
    </body>
</html>
