---
import { getImagesFromFolder } from "../lib/cloudinary";

const images = await getImagesFromFolder(
    "fotografias/romaria-mulheres"
);
---

<html lang="pt-BR">
    <body>
        <h1>Teste Cloudinary</h1>

        <p>Total: {images.length}</p>

        <div class="gallery">
            {
                images.map((image) => (
                    <figure>
                        <img
                            src={image.url}
                            alt="Romaria das Mulheres"
                        />

                        <figcaption>
                            {image.public_id}
                        </figcaption>
                    </figure>
                ))
            }
        </div>
    </body>
</html>

<style>
    .gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    figure {
        margin: 0;
    }

    img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        display: block;
    }

    figcaption {
        font-size: 0.8rem;
        margin-top: 0.5rem;
    }
</style>