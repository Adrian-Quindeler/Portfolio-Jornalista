---
import Layout from "../../../layouts/Layout.astro";
import PhotoGallery from "../../../components/PhotoGallery.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import { galerias } from "../../../data/galerias";

const gallery = galerias.MCMulheres;
---

<Layout title={`${gallery.title} | Mariana Bernardino`}>
    <section class="photo-project container">
        <SectionTitle title={gallery.title} />
        <div class="photo-project-intro">
            <p>{gallery.description}</p>
        </div>
        <PhotoGallery photos={gallery.photos} />
    </section>
</Layout>
