---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<section class="hero container">
		<div class="hero-content">
			<p class="helo-greeting">Olá, eu sou</p>
			<h1 class="hero-title">Mariana Bernardino</h1>
			<p class="hero-role">Jornalista</p>
			<p class="hero-description">Sempre estudando para me tornar melhor!</p>

			<div class="hero-actions">
				<a href="/trabalhos" class="button button-primary">Ver trabalhos</a>
				<a href="/contato" class="button">Contato</a>
			</div>
		</div>
	</section>
</Layout>