---
interface Props {
    href?: string;
    label?: string;
}

const { href = "/", label = "Voltar" } = Astro.props;
---

<a class="page-back" href={href}>
    <svg class="page-back-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
            d="M19 12H6.5M11 6.5 5.5 12l5.5 5.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
    </svg>
    {label}
</a>
