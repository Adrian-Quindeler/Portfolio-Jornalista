---
import Layout from "../../../layouts/Layout.astro";
import PhotoGallery from "../../../components/PhotoGallery.astro";
import PageBack from "../../../components/PageBack.astro";
import { galerias } from "../../../data/galerias";
import { listFolder } from "../../../lib/cloudinary";

const gallery = galerias.romariaCiclistas;
const photos = await listFolder(gallery.folder);
---

<Layout title={`${gallery.title} | Mariana Bernardino`}>
    <section class="photo-project container">
        <PageBack href="/trabalhos/Fotografias" />
        <PhotoGallery
            photos={photos}
            alt={gallery.alt}
            title={gallery.title}
            description={gallery.description}
        />
    </section>
</Layout>
